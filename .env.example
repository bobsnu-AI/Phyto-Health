# Railway 환경변수 설정 예시
# Railway 대시보드 > Variables 탭에서 아래 변수들을 설정하세요

# ── LLM 설정 (필수) ─────────────────────────────────
# Genspark 프록시 사용 시:
GSK_TOKEN=your_genspark_token_here
OPENAI_BASE_URL=https://www.genspark.ai/api/llm_proxy/v1

# 또는 OpenAI 직접 사용 시:
# OPENAI_API_KEY=sk-...
# (OPENAI_BASE_URL은 설정하지 않으면 OpenAI 기본값 사용)

# ── Python 설정 ──────────────────────────────────────
PYTHONUNBUFFERED=1
